# 方案 1：群自定义机器人 webhook（最简单）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-token-here
# Optional, only if the custom bot enables signature verification:
# FEISHU_SECRET=your_feishu_bot_secret_here

# 方案 2：自建应用凭证
# FEISHU_APP_ID=cli_xxxxxxxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxxxxx
# FEISHU_RECEIVE_ID_TYPE=chat_id
# FEISHU_RECEIVE_ID=oc_xxxxxxxxxxxxx
